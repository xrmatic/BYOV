{
  "name": "byov-extension",
  "version": "1.0.0",
  "description": "BYOV browser extension – zero-knowledge password vault",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "argon2-browser": "^1.18.0",
    "firebase": "^12.12.1",
    "libsodium-wrappers": "^0.7.13",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@jest/globals": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-localstorage-mock": "^2.4.26",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["./tests/setup.js"],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "argon2-browser": "<rootDir>/tests/__mocks__/argon2-browser.js",
      "libsodium-wrappers": "<rootDir>/tests/__mocks__/libsodium-wrappers.js"
    }
  }
}
